# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Environment (development, staging, production)
VITE_APP_ENV=development

# Sentry Sampling Rates
# Performance monitoring: 0.0 = none, 1.0 = 100%
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay: 0.0 = none, 1.0 = 100%
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0

# Application URLs (for Sentry filters and routing)
VITE_APP_URL=http://localhost:5173

# ─── ClearPass API ──────────────────────────────────────────────────────────
# Base URL the frontend posts to. Leave as /api to use a same-origin proxy.
VITE_API_BASE_URL=/api

# When true, all domain hooks short-circuit to local mock data (demo mode).
# Set to false once real endpoints are live.
VITE_USE_MOCKS=true

# Simulated network latency for mock mode, in milliseconds.
VITE_MOCK_LATENCY_MS=350
# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://clearpass:clearpass123@localhost:5432/clearpass
# Or individual vars (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clearpass
DB_USER=clearpass
DB_PASSWORD=clearpass123

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS S3 / Cloudflare R2 (document storage) ───────────────────────────────
S3_BUCKET=clearpass-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=                   # Leave blank for AWS, set for Cloudflare R2

# ─── Email (Postmark) ─────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=your-postmark-server-token
EMAIL_FROM=noreply@clearpass.com.ng
EMAIL_FROM_NAME=ClearPass

# ─── Government APIs (fill in when endpoints are provided) ───────────────────
NHIA_API_URL=https://api.nhia.gov.ng/v1
NHIA_API_KEY=
CAC_API_URL=https://api.cac.gov.ng/v1
CAC_API_KEY=
FIRS_API_URL=https://api.firs.gov.ng/v1
FIRS_API_KEY=
PENCOM_API_URL=https://api.pencom.gov.ng/v1
PENCOM_API_KEY=
BPP_API_URL=https://api.bpp.gov.ng/v1
BPP_API_KEY=
NSITF_API_URL=
NSITF_API_KEY=
ITF_API_URL=
ITF_API_KEY=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
